{
  "TokenOptions": {                 //burada yazdığımız audience, issuer gibi alanlar bizim tokenımızın şablonudur.
    "Audience": "umut@umut.com",   //kitle
    "Issuer": "umut@umut.com",      //bunu uygulayan
    "AccessTokenExpiration": 10,       //verdiğimiz tokenın geçerlilik süresi(10 dakika)
    "SecurityKey": "mysupersecretkeymysupersecretkey"        //asp.net'in tokenı kullanacağı anahtarın ismi

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
